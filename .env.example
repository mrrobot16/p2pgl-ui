# Which environment a build is for: development, preview, staging or production.
# Both must be set and the same, or `bun run dev` and `bun run build` stop.
# APP_ENV is for build-time code; NEXT_PUBLIC_APP_ENV is its copy for the browser.
# Each environment's settings are in src/lib/environment/environment-settings.ts.
NEXT_PUBLIC_APP_ENV=development
APP_ENV=development
